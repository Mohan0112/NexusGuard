{
  "name": "nexusguard",
  "private": true,
  "version": "0.1.0",
  "description": "NexusGuard — blast-radius analysis and bounded self-healing for TypeScript monorepos, powered by IBM Bob",
  "workspaces": [
    "packages/*",
    "sample-platform"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w packages/dashboard",
    "analyze": "npm run analyze -w packages/cli",
    "eval": "npm run eval -w packages/cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
