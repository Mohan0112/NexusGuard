# Copy to packages/dashboard/.env.local (dashboard) or export in your shell (CLI / MCP server).
# Never commit real values — .env* files are gitignored.

# IBM Bob Shell (Mode B, headless reasoning)
BOB_API_KEY=
BOB_BIN=bob

# Dashboard
# Repo whose .nexusguard/ run store the dashboard reads reports and events from
NEXUSGUARD_REPO_ROOT=
# Live analysis spawns git, tsc, vitest and Bob Shell. Default: on in `next dev`, off in production.
NEXUSGUARD_ENABLE_ANALYZE=false
# Production only: comma-separated absolute paths of repos that may be analyzed
NEXUSGUARD_ALLOWED_REPOS=
